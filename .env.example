# =========================================================
# Project Odin Overwatch — environment configuration sample
# Copy this file to ".env" and fill in your own values.
# =========================================================

# ---- Discord notifications ----
# Create a webhook in your Discord channel:
#   Channel settings -> Integrations -> Webhooks -> New Webhook
# Paste the full URL here. If left blank, events will still be saved and
# will be retried (sent on a future run) once you configure the webhook.
DISCORD_WEBHOOK_URL=

# ---- GDELT query options ----
# Time window to search, in GDELT "timespan" format. Examples:
#   15min, 1h, 6h, 24h, 3d, 1w
GDELT_TIMESPAN=24h

# Max records per GDELT query. GDELT caps this at 250.
# - In combined mode (default) this is the total cap across all keywords.
# - In per_keyword mode it's the cap per keyword.
GDELT_MAX_RECORDS=200

# Language filter (sourcelang). Use "english" for English-only, or leave
# blank for any language.
GDELT_LANGUAGE=english

# Query mode:
#   combined   = one OR-query covering all keywords (1 API call/run, fast,
#                no rate-limit issues). Recommended.
#   per_keyword = one API call per keyword (slower, prone to 429s; useful
#                if you want per-keyword counts).
GDELT_QUERY_MODE=combined

# ---- Additional sources ----
# Launch Library 2 (thespacedevs.com): real rocket launch data. Free,
# rate-limited at ~15 req/hr (one call per run is fine).
ENABLE_LAUNCH_LIBRARY=true

# FAA Temporary Flight Restrictions. The FAA's endpoint is undocumented
# and the schema occasionally shifts; disable if you see noisy warnings.
ENABLE_FAA_TFR=true

# ---- Storage ----
# SQLAlchemy database URL. The relative sqlite path below resolves
# against the project root, NOT the current working directory — safe
# to run from cron / Task Scheduler.
DATABASE_URL=sqlite:///data/odin.db

# ---- Notifications ----
# Minimum severity that triggers a Discord alert: LOW, MEDIUM, or HIGH.
# Invalid values cause the app to fail fast at startup (rather than
# silently muting all alerts).
MIN_NOTIFY_SEVERITY=MEDIUM

# Safety cap: maximum Discord posts per run, counting both fresh events
# and retried unsent notifications from prior runs. Prevents alert
# storms during breaking-news spikes. Saved-but-uncapped events get
# retried automatically on the next run.
MAX_NOTIFICATIONS_PER_RUN=20

# Comma-separated allow-list of event types that should trigger Discord
# alerts. Leave blank to alert on all classified types. Useful to mute
# noisier buckets without dropping them from the DB / dashboard.
# Valid: DRONE, MISSILE, ROCKET, AIR_DEFENSE, AIRSPACE
# Example below excludes AIR_DEFENSE (the noisiest bucket):
NOTIFY_EVENT_TYPES=DRONE,MISSILE,ROCKET,AIRSPACE

# ---- Logging ----
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path to the rotating log file (relative paths resolve against project
# root). Set blank to disable file logging. Console logging always runs.
LOG_FILE=logs/odin.log

# ---- Heartbeat ----
# Periodic "I'm still alive" Discord post. 0 disables. Set to e.g. 24
# for a daily heartbeat — useful so you notice when the cron job itself
# dies. Requires DISCORD_WEBHOOK_URL.
HEARTBEAT_INTERVAL_HOURS=24
